            "import": "./dist/composables.js",
            "types": "./dist/composables/index.d.ts"
        },
        "./guards": {
            "development": "./app/assets/guards/index.ts",
            "import": "./dist/guards.js",
            "types": "./dist/guards/index.d.ts"
        },
        "./interfaces": {
            "development": "./app/assets/interfaces/index.ts",
            "import": "./dist/interfaces.js",
            "types": "./dist/interfaces/index.d.ts"
        },
        "./routes": {
            "development": "./app/assets/routes/index.ts",
            "import": "./dist/routes.js",
            "types": "./dist/routes/index.d.ts"
        },
        "./stores": {
            "development": "./app/assets/stores/index.ts",
