# Optional development-only settings for the monorepo Docker Compose stack.
# Copy this file to the project root as .env to customize the defaults.

# Enable optional services using a comma-separated list:
# mariadb, pgsql, mysql-test, mariadb-test, pgsql-test, memcached, redis
# COMPOSE_PROFILES=pgsql,pgsql-test,redis

# Uncomment to define the name of the container stack.
# COMPOSE_PROJECT_NAME=userfrosting

# Application database: mysql (default), mariadb, or pgsql.
# Enable the corresponding profile in `COMPOSE_PROFILES`when selecting mariadb or pgsql.
DOCKER_DB_CONNECTION=mysql
DOCKER_DB_NAME=userfrosting
DOCKER_DB_USER=docker
DOCKER_DB_PASSWORD=secret
DOCKER_DB_ROOT_PASSWORD=secret

# Tests use in-memory SQLite by default. To use a server, enable its test
# profile in `COMPOSE_PROFILES` and select mysql, mariadb, or pgsql.
DOCKER_DB_TEST_CONNECTION=mysql
DOCKER_DB_TEST_NAME=userfrosting_test
DOCKER_DB_TEST_USER=userfrosting_test
DOCKER_DB_TEST_PASSWORD=testsecret
DOCKER_DB_TEST_ROOT_PASSWORD=testsecret

# Application cache: file (default), memcached, or redis. When set to memcached 
# or redis, enable the corresponding profile in `COMPOSE_PROFILES`.
DOCKER_CACHE_DRIVER=file

# Ports exposed on the host's loopback interface.
DOCKER_HTTP_PORT=8080
DOCKER_VITE_PORT=5173
DOCKER_MYSQL_PORT=13306
DOCKER_MARIADB_PORT=13307
DOCKER_PGSQL_PORT=15432
DOCKER_SMTP_PORT=1025
DOCKER_MAILPIT_PORT=8025
