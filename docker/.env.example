# Development-only settings for the monorepo Docker Compose stack.
# Docker Compose project and host port settings.

# Use a unique project name and host ports for each checkout.
# COMPOSE_PROJECT_NAME=userfrosting

# Select Database provider : mysql, mariadb, or pgsql (default : mysql).
DOCKER_DB_CONNECTION=mysql

# Database settings shared by all providers.
DOCKER_DB_NAME=userfrosting
DOCKER_DB_USER=docker
DOCKER_DB_PASSWORD=secret

# Test database settings (optional, used by PHPUnit)
# The test database connection should be ONLY set to the same provider as the
# main database or to memory for SQLite.
DOCKER_DB_TEST_CONNECTION=memory
DOCKER_DB_TEST_NAME=userfrosting_test
DOCKER_DB_TEST_USER=userfrosting_test
DOCKER_DB_TEST_PASSWORD=testsecret

# Docker public ports. Change these if they conflict with other services on your host.
DOCKER_HTTP_PORT=8080
DOCKER_VITE_PORT=5173
DOCKER_MYSQL_PORT=13306
DOCKER_MARIADB_PORT=13307
DOCKER_PGSQL_PORT=15432
DOCKER_SMTP_PORT=1025
DOCKER_MAILPIT_PORT=8025

# Administrator credentials are used only by the selected database and setup service.
DOCKER_DB_ROOT_PASSWORD=secret
